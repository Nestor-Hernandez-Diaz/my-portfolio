---
// Herramientas del CV y de los proyectos, agrupadas por área
const techs = [
  'Java', 'Python', 'JavaScript', 'TypeScript', 'C++', 'SQL',
  'HTML', 'CSS', 'React', 'Astro', 'Vite', 'Tailwind CSS', 'Alpine.js', 'Three.js',
  'Node.js', 'Express', 'Spring Boot',
  'MySQL', 'PostgreSQL', 'SQL Server', 'SQLite',
  'Gemini', 'ESP32', 'Blender', 'Power BI', 'Excel',
  'Git', 'GitHub', 'Playwright', 'Vitest', 'Vercel',
];
// Duplicamos para el loop infinito seamless
const doubled = [...techs, ...techs];
---

<div
  class="relative z-10 overflow-hidden py-5 border-y"
  style="border-color: var(--border)"
>
  <div class="marquee-track">
    {doubled.map((tech) => (
      <span
        class="mx-6 text-xs font-bold uppercase tracking-widest whitespace-nowrap select-none"
        style="color: var(--text-muted)"
      >
        {tech}
      </span>
    ))}
  </div>
</div>
