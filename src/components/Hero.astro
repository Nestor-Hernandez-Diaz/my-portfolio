---
import { Image } from 'astro:assets';
import { getLangFromUrl, useTranslations } from '../i18n/ui';
// Foto original recortada a 4:5 (1200×1500); Astro genera versiones WebP más livianas
import profilePhoto from '../assets/profile.jpg';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!-- Hero "Retrato protagonista": texto a la izquierda, foto grande a la derecha.
     Alto = pantalla menos la cinta de tecnologías, para que la cinta se vea sin hacer scroll -->
<section class="flex items-center pt-24 pb-8 px-6 relative z-10" style="min-height: calc(100svh - 4rem)">
  <div class="max-w-7xl mx-auto w-full grid md:grid-cols-[1.15fr_0.85fr] gap-12 lg:gap-16 items-center">

    <!-- Left: Text Content -->
    <div class="space-y-6">

      <!-- Badge de disponibilidad — color primario azul -->
      <div
        class="inline-flex items-center gap-2 glass-panel px-4 py-2 rounded-full
               text-sm font-medium"
        style="color: var(--text-muted)"
      >
        <span
          class="w-2 h-2 rounded-full animate-pulse flex-shrink-0"
          style="background-color: var(--primary)"
        ></span>
        {t('hero.badge')}
      </div>

      <!-- Heading principal -->
      <h1 class="text-5xl md:text-6xl lg:text-7xl font-extrabold leading-tight text-gradient">
        Nestor<br />Hernández Díaz
      </h1>

      <!-- Resumen del CV -->
      <p class="text-lg max-w-xl leading-relaxed" style="color: var(--text-muted)">
        {t('hero.bio')}
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap gap-4 pt-2">
        <a href="#projects" class="btn-primary">
          {t('hero.ctaProjects')}
        </a>

        <!-- CV download funcional — el archivo está en public/cv-nestor.pdf -->
        <a
          href="/cv-nestor.pdf"
          download="cv-nestor-hernandez-diaz.pdf"
          class="btn-glass"
          aria-label={t('hero.cvLabel')}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg" width="16" height="16"
            viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          {t('hero.ctaCv')}
        </a>
      </div>
    </div>

    <!-- Right: foto protagonista con etiquetas flotantes; su alto se limita para no empujar la cinta -->
    <div class="relative w-full max-w-sm md:max-w-none md:w-auto md:h-[min(64svh,600px)] aspect-[4/5] mx-auto">
      <div
        class="relative w-full h-full rounded-3xl overflow-hidden"
        style="box-shadow: 0 0 0 1px rgba(122,162,255,0.35), 0 30px 80px -20px rgba(37,99,235,0.45)"
      >
        <Image
          src={profilePhoto}
          alt={t('hero.photoAlt')}
          widths={[480, 720, 960, 1200]}
          sizes="(min-width: 768px) 480px, 90vw"
          quality={82}
          class="w-full h-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="glass-panel absolute left-3 bottom-4 lg:-left-8 lg:bottom-8 rounded-2xl px-4 py-3 max-w-[15rem]">
        <p class="text-[0.65rem] font-semibold uppercase tracking-widest" style="color: var(--primary)">
          {t('hero.chipEduLabel')}
        </p>
        <p class="text-sm font-semibold leading-snug" style="color: var(--text)">{t('hero.chipEdu')}</p>
      </div>

      <!-- En celular va abajo, sobre la camisa, para no tapar la cara -->
      <div class="glass-panel absolute left-3 bottom-[5.5rem] md:left-auto md:bottom-auto md:right-3 md:top-4 lg:-right-6 lg:top-8 rounded-2xl px-4 py-3 max-w-[13rem]">
        <p class="text-[0.65rem] font-semibold uppercase tracking-widest" style="color: var(--primary)">
          {t('hero.chipNowLabel')}
        </p>
        <p class="text-sm font-semibold leading-snug" style="color: var(--text)">{t('hero.chipNow')}</p>
      </div>
    </div>

  </div>
</section>
