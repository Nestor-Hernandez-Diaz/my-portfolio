---
import { getLangFromUrl, useTranslations, type Localized } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Project {
  category: Localized;
  year: string;
  status?: Localized;
  title: string;
  subtitle?: Localized;
  description: Localized;
  tags: string[];
  site?: string;
  repo?: string;
  accent: string;
  bgFrom: string;
  bgTo: string;
  icon: string;
}

// site y repo son opcionales: los repos privados solo enlazan al sitio publicado
const projects: Project[] = [
  {
    category: { es: 'IoT · Energía solar', en: 'IoT · Solar power' },
    year: '2026',
    status: { es: 'En desarrollo', en: 'In progress' },
    title: 'Hidroponía FISI',
    description: {
      es: 'Propuesta ganadora del Concurso de Hidroponía Sostenible con IoT de la FISI-UNSM, hoy en implementación. Invernadero NFT con sensores en ESP32, energía solar y dashboard de monitoreo. Diseño 3D y planos en Blender, más cotizaciones; se presenta en diciembre de 2026.',
      en: 'Winning proposal of the FISI-UNSM Sustainable Hydroponics with IoT Contest, now being built. An NFT greenhouse with ESP32 sensors, solar power and a monitoring dashboard. 3D design and plans in Blender, plus cost quotes; it will be presented in December 2026.',
    },
    tags: ['ESP32', 'IoT', lang === 'es' ? 'Energía solar' : 'Solar power', 'Dashboard', 'Blender'],
    site: 'https://hidroponia-fisi.vercel.app',
    accent: '#2563EB',
    bgFrom: '#0f172a',
    bgTo: '#1e3a5f',
    icon: `<path d="M7 20h10"/><path d="M10 20c5.5-2.5.8-6.4 3-10"/><path d="M9.5 9.4c1.1.8 1.8 2.2 2.3 3.7-2 .4-3.5.4-4.8-.3-1.2-.6-2.3-1.9-3-4.2 2.8-.5 4.4 0 5.5.8z"/><path d="M14.1 6a7 7 0 0 0-1.1 4c1.9-.1 3.3-.6 4.3-1.4 1-1 1.6-2.3 1.7-4.6-2.7.1-4 1-4.9 2z"/>`,
  },
  {
    category: { es: 'IA · RAG', en: 'AI · RAG' },
    year: '2026',
    title: 'Fisibot',
    subtitle: { es: 'Asistente virtual de la FISI-UNSM', en: 'FISI-UNSM virtual assistant' },
    description: {
      es: 'Asistente con avatar 3D que responde por texto y voz consultas sobre admisión, carreras, trámites y ubicaciones del campus. Las respuestas salen de documentos oficiales mediante RAG (búsqueda híbrida y modelo de lenguaje) y citan su fuente. Desplegado y en uso.',
      en: 'Assistant with a 3D avatar that answers, by text and voice, questions about admissions, degree programs, procedures and campus locations. Answers come from official documents through RAG (hybrid search and a language model) and cite their source. Deployed and in use.',
    },
    tags: ['Node.js', 'Vite', 'Three.js', 'RAG', 'Gemini', 'Vercel', 'Cloudflare Tunnel'],
    site: 'https://fisibot.me',
    accent: '#2563EB',
    bgFrom: '#0f172a',
    bgTo: '#1e3a5f',
    icon: `<path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/>`,
  },
  {
    category: { es: 'ERP · SaaS', en: 'ERP · SaaS' },
    year: '2026',
    title: 'New Hype',
    subtitle: { es: 'ERP SaaS multi-tenant', en: 'Multi-tenant SaaS ERP' },
    description: {
      es: 'ERP para tiendas de ropa: ventas y caja, compras, inventario con kárdex, reportes y auditoría, panel de superadministración y tienda pública por tenant. Autenticación JWT y pruebas con Vitest y Playwright. Equipo de 5 colaboradores; publicado con DOI 10.5281/zenodo.21895543.',
      en: 'ERP for clothing stores: sales and cash register, purchasing, inventory with stock ledger, reports and auditing, a super-admin panel and a public storefront per tenant. JWT authentication and tests with Vitest and Playwright. Team of 5 contributors; published with DOI 10.5281/zenodo.21895543.',
    },
    tags: ['React 19', 'TypeScript', 'Vite', 'Tailwind CSS', 'Spring Boot', 'Java 17', 'MySQL'],
    repo: 'https://github.com/Nestor-Hernandez-Diaz/New-Hype-Project',
    accent: '#2563EB',
    bgFrom: '#0f172a',
    bgTo: '#1e3a5f',
    icon: `<path d="M20 7H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>`,
  },
  {
    category: { es: 'Frontend · Web', en: 'Frontend · Web' },
    year: '2025',
    title: 'GOATs del Fútbol',
    subtitle: { es: 'Enciclopedia web interactiva', en: 'Interactive web encyclopedia' },
    description: {
      es: 'Enciclopedia sobre Messi, Cristiano Ronaldo y Neymar con buscador y filtros por país y posición, fichas de jugador, modo oscuro y registro de usuarios.',
      en: 'Encyclopedia about Messi, Cristiano Ronaldo and Neymar with search and filters by country and position, player profiles, dark mode and user sign-up.',
    },
    tags: ['HTML5', 'Tailwind CSS', 'Alpine.js', 'JavaScript', 'Vercel'],
    site: 'https://goats-del-futbol.vercel.app',
    repo: 'https://github.com/Nestor-Hernandez-Diaz/goats-del-futbol',
    accent: '#2563EB',
    bgFrom: '#0f172a',
    bgTo: '#1e3a5f',
    icon: `<circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/>`,
  },
];
---

<section id="projects" class="py-24 px-6 relative z-10">
  <div class="max-w-7xl mx-auto">

    <!-- Header -->
    <div class="flex items-end justify-between mb-12">
      <div>
        <p class="text-sm font-semibold uppercase tracking-widest mb-2" style="color: var(--primary)">
          {t('projects.eyebrow')}
        </p>
        <h2 class="text-4xl font-bold" style="color: var(--text)">
          {t('projects.title')}
        </h2>
      </div>
      <a
        href="https://github.com/Nestor-Hernandez-Diaz"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden md:inline-flex items-center gap-1 text-sm font-semibold transition-colors"
        style="color: var(--primary)"
      >
        {t('projects.viewAll')}
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round">
          <line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/>
        </svg>
      </a>
    </div>

    <!-- Grid: 2 columnas en tablet+, 4 en desktop wide -->
    <div class="grid sm:grid-cols-2 xl:grid-cols-4 gap-6">
      {projects.map((project) => (
        <article class="glass-panel rounded-2xl overflow-hidden hover-lift group flex flex-col">

          <!-- Visual identity placeholder — reemplazar con screenshot real -->
          <!--
            TODO: Agregar screenshot de cada proyecto.
            Coloca la imagen en public/projects/{slug}.webp y usa:
            <img src="/projects/{slug}.webp" ... />
          -->
          <div
            class="aspect-video w-full relative overflow-hidden flex items-end p-4"
            style={`background: linear-gradient(135deg, ${project.bgFrom} 0%, ${project.bgTo} 100%)`}
          >
            <!-- Icono grande en fondo decorativo -->
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="80" height="80"
              viewBox="0 0 24 24"
              fill="none"
              stroke={project.accent}
              stroke-width="1"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="absolute right-3 top-1/2 -translate-y-1/2 opacity-20
                     group-hover:opacity-30 transition-opacity duration-300"
              set:html={project.icon}
            />
            <!-- Badges de categoría y estado superpuestos -->
            <div class="relative z-10 flex flex-wrap items-center gap-2">
              <span
                class="text-xs font-bold uppercase tracking-widest
                       px-2.5 py-1 rounded-full"
                style={`background: rgba(0,0,0,0.4); color: ${project.accent};
                        border: 1px solid ${project.accent}40`}
              >
                {project.category[lang]}
              </span>
              {project.status && (
                <span
                  class="inline-flex items-center gap-1.5 text-xs font-semibold
                         px-2.5 py-1 rounded-full"
                  style="background: rgba(0,0,0,0.4); color: #e2e8f0;
                         border: 1px solid rgba(226,232,240,0.25)"
                >
                  <span class="w-1.5 h-1.5 rounded-full animate-pulse" style="background: #fbbf24"></span>
                  {project.status[lang]}
                </span>
              )}
            </div>
          </div>

          <!-- Content -->
          <div class="p-5 flex flex-col flex-1 gap-3">

            <!-- Título + año -->
            <div class="flex items-start justify-between gap-2">
              <div>
                <h3 class="text-base font-bold leading-snug" style="color: var(--text)">
                  {project.title}
                </h3>
                {project.subtitle && (
                  <p class="text-xs font-medium mt-0.5" style="color: var(--primary)">
                    {project.subtitle[lang]}
                  </p>
                )}
              </div>
              <span
                class="text-xs flex-shrink-0 font-medium mt-0.5"
                style="color: var(--text-muted)"
              >
                {project.year}
              </span>
            </div>

            <!-- Descripción -->
            <p class="text-xs leading-relaxed flex-1" style="color: var(--text-muted)">
              {project.description[lang]}
            </p>

            <!-- Tags -->
            <div class="flex flex-wrap gap-1.5">
              {project.tags.map((tag) => (
                <span
                  class="text-xs glass-panel px-2 py-0.5 rounded-full"
                  style="color: var(--text-muted)"
                >
                  {tag}
                </span>
              ))}
            </div>

            <!-- CTAs: sitio publicado y/o repositorio -->
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 pt-1">
            {project.site && (
            <a
              href={project.site}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs font-semibold
                     transition-colors"
              style={`color: ${project.accent}`}
            >
              <!-- Icono globo -->
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13"
                   viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <path d="M2 12h20"/>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
              </svg>
              {t('projects.site')}
              <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11"
                   viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/>
              </svg>
            </a>
            )}
            {project.repo && (
            <a
              href={project.repo}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs font-semibold
                     transition-colors"
              style={`color: ${project.accent}`}
            >
              <!-- Icono GitHub -->
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13"
                   viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61
                         c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77
                         5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0
                         C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77
                         a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7
                         A3.37 3.37 0 0 0 9 18.13V22"/>
              </svg>
              {t('projects.repo')}
              <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11"
                   viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </a>
            )}
            </div>

          </div>
        </article>
      ))}
    </div>

  </div>
</section>
